{
  "name": "vibecoder-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check": "turbo check && ruff check .",
    "fix": "biome check --write . && ruff check --fix .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.14.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
